# Shop API Environment Variables
# Copy this file to .env and adjust the values according to your environment

#----------------------------------------------------------------------
# AWS Configuration - Core settings for AWS SDK
#----------------------------------------------------------------------
AWS_REGION=us-east-1           # Required: AWS region where resources are deployed
AWS_PROFILE=default            # Optional: AWS profile to use for credentials (from ~/.aws/credentials)
AWS_OUTPUT=json                # Optional: Output format for AWS CLI (json, text, table)
AWS_SDK_LOAD_CONFIG=1          # Required: Ensures AWS SDK loads config from shared config files

# For AWS SSO users (delete if not using AWS SSO)
AWS_SSO_START_URL=https://example.awsapps.com/start
AWS_SSO_ACCOUNT_ID=123456789012
AWS_SSO_ROLE_NAME=PowerUserAccess

#----------------------------------------------------------------------
# DynamoDB Configuration
#----------------------------------------------------------------------
DYNAMODB_TABLE=ShopAPI         # Required: DynamoDB table name for the application

# For local development with DynamoDB local
# Remove or comment this out when using AWS DynamoDB in production
AWS_ENDPOINT_URL=http://localhost:8000

#----------------------------------------------------------------------
# Product Service Configuration
#----------------------------------------------------------------------
# Scan limit multiplier for product listing queries
# Since DynamoDB applies FilterExpression AFTER Limit, we scan more items
# than requested to account for filtering. Higher values improve results
# but increase DynamoDB read consumption. Default: 100
# Recommended range: 10-200 depending on filter selectivity
PRODUCT_SCAN_MULTIPLIER=100

#----------------------------------------------------------------------
# API Configuration
#----------------------------------------------------------------------
PORT=8080                      # Required: Port for the API server to listen on
DEBUG=true                     # Optional: Enable debug logging (true/false)
RUN_LOCAL=true                 # Optional: Run the server locally (true/false)

#----------------------------------------------------------------------
# Admin Configuration
#----------------------------------------------------------------------
ADMIN_EMAILS=admin@example.com,admin2@example.com  # Comma-separated list of admin email addresses

#----------------------------------------------------------------------
# Logging Configuration
#----------------------------------------------------------------------
LOG_LEVEL=info                 # Optional: Log level (debug, info, warn, error)

#----------------------------------------------------------------------
# Integration Configuration
#----------------------------------------------------------------------
PRINTFUL_API_KEY=              # Required for Printful integration: API key from Printful dashboard